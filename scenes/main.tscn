; T2（minimap）：圆形小地图 UI 容器——挂在 HUD（CanvasLayer）下，
; 锚定右上角（避开左下血条 / 右下弹药列表），180×180px，距屏边 20px。
; 圆形由子节点 Background 上的 ShaderMaterial 径向 alpha 遮罩实现。
; 玩家箭头 + 敌人圆点（T3）作为本容器内 Background 的兄弟 2D Control 叠加。
[node name="Minimap" type="Control" parent="HUD"]
anchor_left = 1.0
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 0.0
offset_left = -200.0
offset_top = 20.0
offset_right = -20.0
offset_bottom = 200.0
grow_horizontal = 0
grow_vertical = 2
mouse_filter = 2

; T2（minimap）：底图——T1 的 ViewportTexture + 径向 alpha ShaderMaterial 裁圆
[node name="Background" type="TextureRect" parent="HUD/Minimap"]
anchor_right = 1.0
anchor_bottom = 1.0
offset_right = 0.0
offset_bottom = 0.0
grow_horizontal = 2
grow_vertical = 2
texture = SubResource("ViewportTexture_minimap")
material = SubResource("ShaderMaterial_minimap_circle")
expand_mode = 1
stretch_mode = 6
mouse_filter = 2

; T3（minimap）：blip 叠加层——2D Control，每帧由 scripts/minimap.gd 重绘
; 玩家箭头（朝向）+ 敌人圆点（melee=红 / ranged=黄）
; 应用径向 alpha 裁剪 shader，超出圆形区域的 blip 自动隐藏，与底图圆边对齐
[node name="Blips" type="Control" parent="HUD/Minimap"]
anchor_right = 1.0
anchor_bottom = 1.0
offset_right = 0.0
offset_bottom = 0.0
grow_horizontal = 2
grow_vertical = 2
material = SubResource("ShaderMaterial_minimap_blip_clip")
mouse_filter = 2
script = ExtResource("15_minimap")

