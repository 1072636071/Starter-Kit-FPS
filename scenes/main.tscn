; T2（minimap）：圆形遮罩 shader——径向 alpha 把方形 SubViewport 渲染裁成圆
[sub_resource type="Shader" id="Shader_minimap_circle"]
code = "shader_type canvas_item;

void fragment() {
	vec2 center = vec2(0.5, 0.5);
	float dist = distance(UV, center);
	// 圆内不透明，圆外透明，边缘 0.04 软过渡隐藏俯视渲染四角畸变
	float alpha = smoothstep(0.5, 0.46, dist);
	vec4 c = texture(TEXTURE, UV);
	COLOR = vec4(c.rgb, c.a * alpha);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_minimap_circle"]
shader = SubResource("Shader_minimap_circle")

; T3（minimap）：blip 层圆形裁剪 shader——只对绘制像素的 alpha 做径向衰减，
; 不覆盖 rgb（与 T2 的底图 shader 区别：底图采样 TEXTURE.rgb；blip 层直接用绘制 COLOR.rgb）
[sub_resource type="Shader" id="Shader_minimap_blip_clip"]
code = "shader_type canvas_item;

void fragment() {
	vec2 center = vec2(0.5, 0.5);
	float dist = distance(UV, center);
	float mask = smoothstep(0.5, 0.46, dist);
	COLOR.a *= mask;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_minimap_blip_clip"]
shader = SubResource("Shader_minimap_blip_clip")

; T2（minimap）：绑定 T1 产出的 ViewportTexture；viewport_path 相对于场景根（Main）
[sub_resource type="ViewportTexture" id="ViewportTexture_minimap"]
viewport_path = NodePath("MinimapViewport")

[node name="Main" type="Node3D" unique_id=1176673032]

; T1（minimap）：俯视渲染基建——SubViewport + 正交俯视 Camera3D。
; 相机 cull_mask = layer 1（仅世界/地形），固定位于世界中心正上方 y=80m，
; 正交 size = 160m（Godot 4 中 size 为视口全高，非半高）→ 半高 80m → 覆盖整个 160×160 世界（边界 ±80）。
; 相机本身不随玩家移动（全图固定，见 ADR 007「缩放」与 CONTEXT.md「Minimap Zoom」）。
; 武器 viewmodel 在 layer 2，cull_mask 不含 layer 2，天然不进图。
; 怪物真实 mesh 已挪到 layer 3（见 monster_melee/ranged.tscn），故俯视渲染无敌人 blob。
[node name="MinimapViewport" type="SubViewport" parent="."]
transparent_bg = true
size = Vector2i(256, 256)
render_target_update_mode = 4

[node name="MinimapCamera" type="Camera3D" parent="MinimapViewport"]
; 旋转 -90° 绕 X 轴：相机本地 -Z（前向）→ 世界 -Y（朝下）；本地 +Y（图像上方）→ 世界 -Z（北）
; tscn 的 Transform3D 12 个浮点按行存储（row0, row1, row2, origin）
transform = Transform3D(1, 0, 0, 0, 0, 1, 0, -1, 0, 0, 80, 0)
projection = 1
size = 160.0
cull_mask = 1
current = false
far = 1000.0

